

{
  "manifest_version": 3,
  "name": "CalmUI - Adaptive Interface",
  "version": "1.0.0",
  "description": "Customize websites to match your sensory and cognitive preferences.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
  "http://*/*",
  "https://*/*",
  "http://localhost:3000/*"
],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CalmUI"
  },
  "background": {
  "service_worker": "background.js"
},
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}

